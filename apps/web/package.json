{
  "name": "web",
  "description": "Todo web app: works offline, syncs with todo-server.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
